# Local backend selector goes in root .env.local. Copy web values into apps/web/.env.local.
# Never commit real secret values.

# Clerk (pull with: clerk env pull --instance dev --file .env.local)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Convex (written by: npx convex dev)
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Encrypts the TRMNL install/management handoff cookies: 32 random bytes, base64url.
INSTALL_FLOW_KEY=generate-with-openssl-rand-base64-32

# TRMNL plugin Client ID (not secret): management JWT audience.
TRMNL_CLIENT_ID=your-client-id

# Convex deployment env (set with npx convex env set NAME=value, not in this file):
#   CLERK_JWT_ISSUER_DOMAIN, CLERK_SECRET_KEY, TRMNL_CLIENT_ID, TRMNL_CLIENT_SECRET,
#   CLERK_WEBHOOK_SECRET (whsec_..., endpoint /auth/clerk/webhook, event user.deleted),
#   ADMIN_TOKEN_IDENTIFIERS, RESEND_API_KEY (optional, enables incident email),
#   COMPANION_ORIGIN (optional, QR target origin; default https://trmnlgames.com),
#   ALERT_TO / ALERT_FROM (optional overrides). Never set DEV_SEED_ENABLED in production.
