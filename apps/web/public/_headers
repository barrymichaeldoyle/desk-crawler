# Cloudflare Workers static assets. Vite fingerprints everything under /assets, so a file never changes at its URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts keep their names across builds; a week, then revalidate.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The push worker (P33) must be fetched fresh so an update reaches every browser.
/push-sw.js
  Cache-Control: no-cache
