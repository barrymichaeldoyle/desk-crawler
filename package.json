{
  "name": "trmnl-games",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @trmnl-games/web dev",
    "build": "pnpm --filter @trmnl-games/web build",
    "preview": "pnpm --filter @trmnl-games/web preview",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx tools/balance/run.ts",
    "balance:raids": "tsx tools/balance/raids.ts",
    "lint:trmnl:setup": "tsx tools/trmnl/lint.ts --install",
    "lint:trmnl": "tsx tools/trmnl/lint.ts",
    "crosscheck:trmnl": "tsx tools/trmnl/crosscheck.ts",
    "sweep:trmnl": "node tools/trmnl/sweep.mjs",
    "pull:trmnl": "node tools/trmnl/pull-live.mjs",
    "check": "pnpm typecheck && pnpm test",
    "build:deploy": "node tools/deploy/check-target.mjs && pnpm check && convex deploy -y --cmd 'pnpm build'",
    "deploy:web": "pnpm --filter @trmnl-games/web run deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.60",
    "jsqr": "^1.4.0",
    "liquidjs": "^10.30.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.6.4",
    "@convex-dev/react-query": "^0.1.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@trmnl-games/backend": "workspace:*",
    "@trmnl-games/desk-crawler": "workspace:*",
    "@trmnl-games/engine": "workspace:*",
    "@trmnl-games/platform": "workspace:*",
    "convex": "^1.46.0",
    "jose": "^6.2.12",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
